##
# ****
# xemu
# ****
#
# Automation commands specific to xemu.  Frames are counted in guest
# vblanks: the counter advances once per vblank while the VM runs and
# stands still while it is paused.
##

{ 'include': 'run-state.json' }

##
# @XemuTraceRegion:
#
# Guest memory that @xemu-frame-advance reads at each traced vblank.
#
# @address: physical address, or with @virtual a virtual one (CPU 0's
#     page tables at that vblank)
#
# @size: bytes to read, 1 to 4096
#
# @virtual: translate @address through the guest page tables (default
#     false)
#
# Since: 10.2
##
{ 'struct': 'XemuTraceRegion',
  'data': { 'address': 'uint64', 'size': 'int', '*virtual': 'bool' } }

##
# @XemuTraceSample:
#
# @frame: the frame counter at the vblank the sample was taken at
#
# @data: one lowercase hex string per traced region, in request
#     order; an empty string when guest RAM does not back the whole
#     region (an unmapped virtual page)
#
# Since: 10.2
##
{ 'struct': 'XemuTraceSample',
  'data': { 'frame': 'int', 'data': ['str'] } }

##
# @XemuFrameInfo:
#
# @frame: vblanks delivered while the VM was running, since launch
#
# @running: whether the VM is running
#
# @vblank-ns: the guest vblank period in nanoseconds: 16666666 (60
#     Hz), or 20000000 (50 Hz) while the opt-in [sys] vblank_rate
#     picks 50 Hz; @frame counts these vblanks (since 10.2, xemu-macos
#     0.16.1)
#
# @trace: the samples @xemu-frame-advance took (only when it was
#     given @trace)
#
# @debug-stop: true when a gdbstub breakpoint or step stopped the VM
#     before @xemu-frame-advance reached its frame; the VM is left
#     stopped for the debugger
#
# @stopped: the run state of a stop that @xemu-frame-advance didn't
#     make and that ended it before its frame: debug (with
#     @debug-stop), paused (a gdbstub client attached, sent ^C, or
#     sent a byte while the VM ran), io-error, shutdown...  The VM is
#     left as that stop left it.  A save or load (save-vm,
#     restore-vm) starts the VM again before it returns and doesn't
#     end an advance, unless it fails and leaves the VM stopped, as a
#     failed HMP loadvm or snapshot-load does: then @stopped is
#     restore-vm.
#
# @hooks: the hits of the @xemu-hooks-set hooks since the last reply
#     that carried them (only from @xemu-frame-advance, while a hook
#     is installed or records are waiting)
#
# @gpu-counters: the NV2A work of the advance (only from
#     @xemu-frame-advance with @gpu-counters; xemu-macos 0.16.1)
#
# @render-flips: frames drawn since the request, up to the stop
#     (only from @xemu-render-next; more than its @flips when the
#     guest drew another first, fewer when its @frames ran out;
#     xemu-macos 0.16.1)
#
# Since: 10.2
##
{ 'struct': 'XemuFrameInfo',
  'data': { 'frame': 'int', 'running': 'bool', '*vblank-ns': 'int',
            '*trace': ['XemuTraceSample'], '*debug-stop': 'bool',
            '*stopped': 'RunState', '*hooks': 'XemuHookTrace',
            '*gpu-counters': 'XemuGpuCounters',
            '*render-flips': 'int' } }

##
# @query-xemu-frame:
#
# Return the current frame counter.
#
# Since: 10.2
##
{ 'command': 'query-xemu-frame', 'returns': 'XemuFrameInfo' }

##
# @XemuLanguage:
#
# The console language a run gives the guest, as @xemu-set-language
# reports it (xemu-macos 0.16.1).
#
# @language: the language the guest reads: its code (en ja de fr es
#     it ko zh pt), the number for another value, or "off" when the
#     guest reads the EEPROM's own
#
# @value: its XC_LANGUAGE number (1 English, 2 Japanese, 3 German,
#     4 French, 5 Spanish, 6 Italian, 7 Korean, 8 Chinese,
#     9 Portuguese), 0 when off
#
# @eeprom: the language the machine's EEPROM holds
#
# @kernel-copies: copies of the EEPROM image in guest RAM (the
#     kernel's cache) this call set the language in
#
# Since: 10.2
##
{ 'struct': 'XemuLanguage',
  'data': { 'language': 'str', 'value': 'int', 'eeprom': 'int',
            'kernel-copies': 'int' } }

##
# @xemu-set-language:
#
# Set the console language the guest reads for the rest of the run,
# as XEMU_LANGUAGE does from launch (xemu-macos 0.16.1).  The guest's
# EEPROM reads return it (the device keeps the EEPROM's own: a guest
# EEPROM write lands with the EEPROM's language and a checksum of its
# own, and stays out of the EEPROM file while the language is set),
# and this call and every later load (loadvm,
# xemu-checkpoint-restore, an incoming migration) set it in the
# kernel's copy of the EEPROM in guest RAM, so every language query
# returns it.  That copy is guest RAM: a load whose state holds
# another language then ends on other RAM than a plain load.  A title
# that asks once per boot (Azurik) keeps what it asked until the next
# boot.  The VM must be stopped.
#
# @language: a code (en ja de fr es it ko zh pt), a name (french,
#     German...), an XC_LANGUAGE number, or "off" to give the guest
#     the EEPROM's own again (also set in the kernel's copy); absent:
#     only report
#
# Since: 10.2
##
{ 'command': 'xemu-set-language', 'data': { '*language': 'str' },
  'returns': 'XemuLanguage' }

##
# @xemu-frame-advance:
#
# Run the VM for @frames vblanks, then pause it.  Returns once it is
# paused.  With @frames 0 the VM is just paused.  A VM the gdbstub
# stopped runs on from the instruction it stopped at.
#
# @frames: vblanks to run (default 1)
#
# @trace: guest memory to read at every @trace-every'th vblank of the
#     advance, the last one included, before the guest sees that
#     vblank (at most 256 regions).  Under -icount the samples are
#     exact; otherwise the vCPU may be mid-update.
#
# @trace-every: vblanks between samples (default 1)
#
# @gpu-counters: count the NV2A work of the advance, from its start to
#     its stop, and return it in @gpu-counters (as
#     @xemu-gpu-counters-start and -stop around it would; fails while
#     those count; xemu-macos 0.16.1)
#
# @gpu-counters-per-flip: with @gpu-counters, also return one set per
#     flip (xemu-macos 0.16.1)
#
# Since: 10.2
##
{ 'command': 'xemu-frame-advance',
  'data': { '*frames': 'int', '*trace': ['XemuTraceRegion'],
            '*trace-every': 'int', '*gpu-counters': 'bool',
            '*gpu-counters-per-flip': 'bool' },
  'returns': 'XemuFrameInfo', 'coroutine': true }

##
# @XemuRamDump:
#
# @size: bytes written
#
# @ram-size: guest RAM size in bytes (64 MiB retail, 128 MiB devkit)
#
# @frame: the frame counter (see @query-xemu-frame) at the copy
#
# @paused: whether the VM was paused during the copy; a copy of a
#     running VM is torn
#
# @unmapped: pages written as zeros because no guest RAM backs them
#     (virtual dumps only)
#
# @elapsed-us: time spent copying and writing, in microseconds
#
# Since: 10.2
##
{ 'struct': 'XemuRamDump',
  'data': { 'size': 'uint64', 'ram-size': 'uint64', 'frame': 'int',
            'paused': 'bool', 'unmapped': 'int', 'elapsed-us': 'int' } }

##
# @xemu-dump-ram:
#
# Write guest memory to a file in one write: all of guest RAM by
# default, or [@address, @address + @size).
#
# @filename: file to create or truncate
#
# @address: physical start address, or with @virtual a virtual one
#     (CPU 0's page tables); default 0
#
# @size: bytes to write; default the rest of RAM (required with
#     @virtual)
#
# @virtual: translate through the guest page tables; pages that no
#     guest RAM backs (unmapped, or MMIO) read as zeros (default
#     false)
#
# @pause: pause the VM for the copy and resume it afterwards if it was
#     running (default true)
#
# @gpu-sync: when paused, first write GPU-rendered surfaces back to
#     RAM, as savevm does (default true; nothing to do with the null
#     renderer)
#
# Since: 10.2
##
{ 'command': 'xemu-dump-ram',
  'data': { 'filename': 'str', '*address': 'uint64', '*size': 'uint64',
            '*virtual': 'bool', '*pause': 'bool', '*gpu-sync': 'bool' },
  'returns': 'XemuRamDump' }

##
# @XemuCheckpointInfo:
#
# @name: the checkpoint's name
#
# @size: bytes of host memory it holds itself: its device state and
#     @ram-pages pages
#
# @ram-pages: guest RAM pages (4 KiB) it holds a copy of; the others
#     are zero, or shared with the checkpoint it was saved against
#
# @base: the checkpoint it was saved against (see
#     @xemu-checkpoint-save)
#
# @frame: the frame counter (see @query-xemu-frame) when it was saved
#
# @disk-sectors: disk sectors the guest has written since, kept as
#     they were at the checkpoint
#
# @elapsed-us: how long the save or restore took, in microseconds
#
# @pages-checked: the RAM pages a save compared with its base's
#     (every page without one), or a restore with the checkpoint's
#     (every page unless @incremental)
#
# @pages-copied: after a restore, the RAM pages it wrote back because
#     they differed
#
# @pages-missed: after a save against a base or an incremental
#     restore, with @verify: the RAM pages that differed although the
#     dirty log hadn't named them (stored or written back all the
#     same); anything but 0 is a writer the log misses
#
# Since: 10.2
##
{ 'struct': 'XemuCheckpointInfo',
  'data': { 'name': 'str', 'size': 'uint64', 'ram-pages': 'uint64',
            '*base': 'str', 'frame': 'int',
            'disk-sectors': 'int', '*elapsed-us': 'int',
            '*pages-checked': 'uint64', '*pages-copied': 'uint64',
            '*pages-missed': 'uint64' } }

##
# @xemu-checkpoint-save:
#
# Save the whole machine state to host memory, as savevm would to the
# disk image (an existing checkpoint of that name is replaced).  The
# VM keeps its run state.  Sectors the guest writes to its disks from
# now on are kept, so a restore reverts them as loadvm would.
#
# @name: the checkpoint's name
#
# @base: an existing checkpoint (it may be @name's): store only the
#     RAM pages that differ from its RAM and share the rest with it
#     (deleting or replacing @base later keeps them).  It also starts
#     the dirty log that incremental restores use, so the next saves
#     against a base compare only the pages written since the last
#     save or restore.
#
# @verify: with @base, also compare every page the dirty log didn't
#     name, and report the ones that differed in @pages-missed
#     (default false)
#
# Since: 10.2
##
{ 'command': 'xemu-checkpoint-save',
  'data': { 'name': 'str', '*base': 'str', '*verify': 'bool' },
  'returns': 'XemuCheckpointInfo' }

##
# @xemu-checkpoint-restore:
#
# Restore a checkpoint, as loadvm restores a snapshot: the machine is
# reset, loaded, its disks reverted, and it runs again only if it was
# running.  A checkpoint can be restored any number of times.
#
# @name: the checkpoint's name
#
# @incremental: compare and write back only the RAM pages that may
#     differ: those written since the last checkpoint save or restore
#     (QEMU's migration dirty log, which this starts), and those the
#     two checkpoints hold differently.  The machine ends as a full
#     restore leaves it.  The first one, and the first after a loadvm,
#     an incoming migration or a failed restore, compares every page.
#     Writes into guest RAM from another process (XEMU_RAM_SHM) are
#     not seen.  The log stops when the last checkpoint is deleted.
#     (default false)
#
# @verify: with @incremental, also compare every other page, and
#     report the ones that differed in @pages-missed (default false)
#
# Since: 10.2
##
{ 'command': 'xemu-checkpoint-restore',
  'data': { 'name': 'str', '*incremental': 'bool', '*verify': 'bool' },
  'returns': 'XemuCheckpointInfo' }

##
# @xemu-checkpoint-delete:
#
# Free a checkpoint.
#
# @name: the checkpoint's name
#
# Since: 10.2
##
{ 'command': 'xemu-checkpoint-delete', 'data': { 'name': 'str' } }

##
# @query-xemu-checkpoints:
#
# List the checkpoints in host memory.
#
# Since: 10.2
##
{ 'command': 'query-xemu-checkpoints', 'returns': ['XemuCheckpointInfo'] }

##
# @XemuDigestAlgorithm:
#
# How @xemu-ram-digest hashes.
#
# @sha256: SHA-256 (the whole-RAM hash equals the sha256 of
#     @xemu-dump-ram's file)
#
# @xxh3-128: XXH3-128 for all of RAM and XXH3-64 per page (xxHash
#     0.8, canonical big-endian byte order, as xxhsum prints them):
#     about 15 times faster, but not a cryptographic hash
#
# Since: 10.2
##
{ 'enum': 'XemuDigestAlgorithm', 'data': [ 'sha256', 'xxh3-128' ] }

##
# @XemuRamDigest:
#
# @sha256: lowercase hex sha256 of all of guest RAM, which is the
#     sha256 of @xemu-dump-ram's file (only with @algorithm sha256;
#     absent with @sha256 false)
#
# @xxh3-128: 32 lowercase hex digits, the XXH3-128 of all of guest RAM
#     (only with @algorithm xxh3-128; absent with @sha256 false)
#
# @ram-size: guest RAM size in bytes (64 MiB retail, 128 MiB devkit)
#
# @frame: the frame counter (see @query-xemu-frame) at the digest
#
# @page-hashes: with @pages, 16 lowercase hex digits per 4 KiB page,
#     in address order: the first 8 bytes of the page's sha256, or
#     with @algorithm xxh3-128 the page's XXH3-64
#
# @differ: with @against, the pages whose bytes differ from the
#     checkpoint's, as ascending page numbers (physical address
#     divided by 4096)
#
# @elapsed-us: time spent hashing and comparing, in microseconds
#
# Since: 10.2
##
{ 'struct': 'XemuRamDigest',
  'data': { '*sha256': 'str', '*xxh3-128': 'str', 'ram-size': 'uint64',
            'frame': 'int',
            '*page-hashes': 'str', '*differ': ['int'],
            'elapsed-us': 'int' } }

##
# @xemu-ram-digest:
#
# Hash guest RAM in place: no file, and no write-back of GPU-rendered
# surfaces (unlike @xemu-dump-ram's default @gpu-sync).  The VM is
# paused for it and resumes if it was running.
#
# @sha256: hash all of RAM, with @algorithm (default true, or false
#     with @against)
#
# @pages: also return @page-hashes (default false)
#
# @against: a checkpoint's name (see @xemu-checkpoint-save): return
#     @differ, the pages that differ from the RAM it holds
#
# @algorithm: the hash for all of RAM and for @page-hashes (default
#     sha256)
#
# Since: 10.2
##
{ 'command': 'xemu-ram-digest',
  'data': { '*sha256': 'bool', '*pages': 'bool', '*against': 'str',
            '*algorithm': 'XemuDigestAlgorithm' },
  'returns': 'XemuRamDigest' }

##
# Readiness and device events
# ===========================
##

##
# QMP events for what the stderr lines "xemu: ready", "xemu: state
# loaded" and "xemu: Vulkan device lost; exiting" report; the lines
# stay.  A client receives an event only once it has sent
# qmp_capabilities, so one that connects at launch reads
# @query-xemu-status after negotiating and waits for @XEMU_READY only
# while @ready is false.
##

##
# @XemuStatus:
#
# @ready: @XEMU_READY has been emitted (the machine and its pads
#     exist; a loadvm or an incoming migration works from then on)
#
# @loads: successful machine state loads since launch (see
#     @XEMU_STATE_LOADED)
#
# Since: 10.2
##
{ 'struct': 'XemuStatus',
  'data': { 'ready': 'bool', 'loads': 'int' } }

##
# @query-xemu-status:
#
# Return whether xemu is ready and how many loads it has made.
#
# Since: 10.2
##
{ 'command': 'query-xemu-status', 'returns': 'XemuStatus' }

##
# @XemuDisplayInfo:
#
# How old the frame is that @screendump writes.  A flip is a guest
# write of the CRTC start address (NV_PCRTC_START), which puts a
# finished frame on screen; D3D titles make one or more at every
# present.  @screendump writes the frame on screen: the last flip's
# or, before the first flip after a load, the loaded state's own (the
# one it showed when it was saved).
#
# @frame: the frame counter now (see @query-xemu-frame)
#
# @loads: successful machine state loads since launch (see
#     @query-xemu-status)
#
# @flips: flips since launch
#
# @flip-frame: the frame counter at the last flip (absent before the
#     first)
#
# @flip-loads: @loads at the last flip (absent before the first); less
#     than @loads until the first flip after the last load
#
# @scanout: the guest physical address on screen (the CRTC start)
#
# @picture-loads: @loads at the GPU's last write (a draw, clear or 2D
#     blit) into the buffer on screen, the colour surface holding
#     @scanout, counting writes only once a frame begun after that
#     load has ended (absent before the first such write since launch,
#     and with the null renderer) (xemu-macos 0.16.1).  The frame on
#     screen changes when the GPU writes that buffer, which a flip
#     need not do (Azurik writes the same CRTC start every vblank).
#     Less than @loads until the guest draws into the buffer on screen
#     after the last load or @xemu-checkpoint-restore: until then
#     @screendump writes the loaded state's own frame, as the loaded
#     RAM holds it, whatever @flip-loads says
#
# @picture-frame: the frame counter at that write (xemu-macos 0.16.1)
#
# @frame-ends: the guest's frame ends since launch (NV097 FLIP_STALL:
#     the frames it renders, which @xemu-frame-advance's @gpu-counters
#     count as flips), counted whether or not the GPU counters run;
#     their difference over a span of @frame is the frame rate, at no
#     counting cost (xemu-macos 0.16.3)
#
# @picture-stale: true while the picture on screen predates the last
#     load: no GPU write into the buffer on screen has counted since
#     that load (@picture-loads less than @loads, or absent after a
#     load).  Present whenever a renderer that draws runs (not the
#     null one), from the first query on (xemu-macos 0.16.1).  Date a
#     picture by this, not by @flip-loads.  A buffer on screen that
#     only the CPU or the video overlay writes stays stale after a
#     load until the GPU writes it
#
# Since: 10.2
##
{ 'struct': 'XemuDisplayInfo',
  'data': { 'frame': 'int', 'loads': 'int', 'flips': 'int',
            '*flip-frame': 'int', '*flip-loads': 'int',
            'scanout': 'uint64',
            '*picture-loads': 'int', '*picture-frame': 'int',
            '*picture-stale': 'bool', 'frame-ends': 'int' } }

##
# @query-xemu-display:
#
# Return when the guest last flipped, which dates the frame
# @screendump writes.  It reads counters only.
#
# Since: 10.2
##
{ 'command': 'query-xemu-display', 'returns': 'XemuDisplayInfo' }

##
# @XEMU_READY:
#
# Emitted once per launch, when the machine and its pads exist, just
# before the stderr line "xemu: ready".
#
# Since: 10.2
##
{ 'event': 'XEMU_READY' }

##
# @XemuLoadSource:
#
# What loaded a machine state.
#
# @loadvm: a snapshot in the disk image (HMP loadvm, QMP
#     snapshot-load, the UI, -loadvm)
#
# @checkpoint: @xemu-checkpoint-restore
#
# @incoming: an incoming migration (-incoming, migrate-incoming)
#
# Since: 10.2
##
{ 'enum': 'XemuLoadSource',
  'data': [ 'loadvm', 'checkpoint', 'incoming' ] }

##
# @XEMU_STATE_LOADED:
#
# Emitted after each successful load of a machine state, with the
# stderr line "xemu: state loaded": before loadvm, snapshot-load's job
# or @xemu-checkpoint-restore returns, and when an incoming migration
# has read its stream.  A failed load emits nothing.
#
# @source: what loaded it
#
# @name: the snapshot or checkpoint (absent for an incoming migration)
#
# @frame: the frame counter (see @query-xemu-frame) at the load
#
# @loads: successful loads since launch, this one included
#
# Since: 10.2
##
{ 'event': 'XEMU_STATE_LOADED',
  'data': { 'source': 'XemuLoadSource', '*name': 'str', 'frame': 'int',
            'loads': 'int' } }

##
# @XemuDeviceLostReason:
#
# @device-lost: the GPU driver returned VK_ERROR_DEVICE_LOST
#
# @fence-timeout: a GPU fence did not signal within 60 s (a hung
#     GPU or driver)
#
# Since: 10.2
##
{ 'enum': 'XemuDeviceLostReason',
  'data': [ 'device-lost', 'fence-timeout' ] }

##
# @XEMU_DEVICE_LOST:
#
# Emitted at most once, when the Vulkan renderer loses its GPU
# device, just before xemu ends: a headless xemu then prints "xemu:
# Vulkan device lost; exiting" (after a fence timeout, "xemu: Vulkan
# call failed; exiting") and exits with status 1; a windowed one
# prints its diagnostic and aborts.
# Delivery is best effort: the event is lost if the client left
# earlier output unread.
#
# @reason: what failed
#
# @where: the wait that failed (absent when a Vulkan call returned the
#     error)
#
# @vk-result: the VkResult
#
# Since: 10.2
##
{ 'event': 'XEMU_DEVICE_LOST',
  'data': { 'reason': 'XemuDeviceLostReason', '*where': 'str',
            'vk-result': 'int' } }

##
# @XEMU_PRESENT_STALL:
#
# Emitted when a windowed present (Metal presentation backend) has
# waited past the drawable bound, XEMU_PRESENT_STALL_MS (default 100
# ms), for a CAMetalLayer drawable, once per stall: the UI thread
# drops frames (with push present the step it consumed, a frame
# interpolation midpoint or a real frame) and keeps polling input
# (pads and the input pipe) and serving screendumps at about 60 Hz
# until a drawable comes; the HUD and menus wait for it.  For every
# stall stderr gets "xemu: present stall N: no drawable for M ms;
# dropping frames until one comes" at the start and "xemu: present
# stall N over after M ms, F frames dropped" at the end.  Emulation
# never waits for the present (xemu-macos 0.16.1).
#
# @waited-ms: how long the frame that started the stall waited
#
# @count: stalls since launch, this one included
#
# Since: 10.2
##
{ 'event': 'XEMU_PRESENT_STALL',
  'data': { 'waited-ms': 'int', 'count': 'int' } }

##
# Strict CPUID
# ============
##

##
# @XemuCpuidFeature:
#
# A CPUID feature an instruction needs.
#
# @mmx: MMX
#
# @sse: SSE
#
# @sse2: SSE2
#
# @sse3: SSE3
#
# Since: 10.2
##
{ 'enum': 'XemuCpuidFeature',
  'data': [ 'mmx', 'sse', 'sse2', 'sse3' ] }

##
# @XEMU_CPUID_FAULT:
#
# Emitted when xemu runs with XEMU_STRICT_CPUID=1 and the guest
# executes an instruction its CPU model lacks (on the Xbox's
# pentium3: any SSE2 or SSE3 instruction), just before the
# instruction raises #UD, with the stderr line "xemu: strict CPUID:
# #UD at ...".  Reported for the first 32 such faults of a launch;
# later ones still raise #UD.
#
# @pc: linear address of the instruction (CS base plus EIP)
#
# @feature: what it needs
#
# @opcode: its SSE prefix, escape and opcode bytes and ModRM byte, in
#     hex ("F2 0F 58 C1" for addsd xmm0, xmm1)
#
# @count: strict-CPUID faults since launch, this one included
#
# Since: 10.2
##
{ 'event': 'XEMU_CPUID_FAULT',
  'data': { 'pc': 'int', 'feature': 'XemuCpuidFeature', 'opcode': 'str',
            'count': 'int' } }

##
# @XEMU_GUEST_BUGCHECK:
#
# Emitted when xemu runs with XEMU_GUEST_BUGCHECK=1 and the guest
# kernel enters KeBugCheckEx (export 96, which KeBugCheck, export 95,
# calls), before its first instruction, with the stderr line "xemu:
# guest bugcheck 0x<code> (<p1>, <p2>, <p3>, <p4>) from <caller>".
# xemu finds the function in the export table of the kernel image at
# 0x80010000 ("xemu: guest bugcheck: KeBugCheckEx at ... hooked") at
# each load, before the guest runs on, and in a boot at the second
# vblank that finds the image in place.  The 4627 kernel then halts
# with interrupts disabled (see XEMU_GUEST_HALTED).  Reported for the
# first 16 bugchecks of a launch.  (xemu-macos 0.16.1)
#
# @code: the bug check code
#
# @params: its four parameters
#
# @caller: the return address KeBugCheckEx was called with
#
# @count: bugchecks since launch, this one included
#
# @regs: the registers at KeBugCheckEx's first instruction (EIP is
#     KeBugCheckEx; ESP points at @caller), also on stderr as "xemu:
#     guest bugcheck registers: ..." (xemu-macos 0.16.5)
#
# @stack: guest memory from that ESP up, in lowercase hex: 4 KiB, or
#     up to the first page that isn't readable RAM.  For a
#     KMODE_EXCEPTION_NOT_HANDLED (0x1E) the trap frame and the
#     exception's context record are in it, each where the faulting
#     EIP (the second parameter) is followed by CS 0x0008.  Never on
#     stderr (xemu-macos 0.16.5)
#
# Since: 10.2
##
{ 'event': 'XEMU_GUEST_BUGCHECK',
  'data': { 'code': 'uint32', 'params': [ 'uint32' ], 'caller': 'uint32',
            'count': 'int', '*regs': 'XemuRegs', '*stack': 'str' } }

##
# @XEMU_GUEST_HALTED:
#
# Emitted when xemu runs with XEMU_GUEST_BUGCHECK=1 and the guest
# executes HLT with interrupts disabled, which only a reset or an NMI
# ends: the kernel's halt after a bugcheck (the 4627 kernel's "cli;
# hlt; jmp" at 0x800151ED, which also ends its double-fault handler),
# with the stderr line "xemu: guest halted with interrupts disabled at
# <eip>".  Reported for the first 16 such halts of a launch.
# (xemu-macos 0.16.1)
#
# @eip: EIP after the HLT, where the guest stays (0x800151EF on the
#     4627 kernel)
#
# @esp: ESP
#
# @count: such halts since launch, this one included
#
# Since: 10.2
##
{ 'event': 'XEMU_GUEST_HALTED',
  'data': { 'eip': 'uint32', 'esp': 'uint32', 'count': 'int' } }

##
# Guest PC hooks: run-until
# =========================
##

##
# @XemuHookReg:
#
# A guest register a hook condition reads.
#
# @eax: EAX
#
# @ecx: ECX
#
# @edx: EDX
#
# @ebx: EBX
#
# @esp: ESP
#
# @ebp: EBP
#
# @esi: ESI
#
# @edi: EDI
#
# @eip: EIP (the hooked instruction's)
#
# @eflags: EFLAGS
#
# Since: 10.2
##
{ 'enum': 'XemuHookReg',
  'data': [ 'eax', 'ecx', 'edx', 'ebx', 'esp', 'ebp', 'esi', 'edi',
            'eip', 'eflags' ] }

##
# @XemuHookCmp:
#
# How a hook condition compares its operand with its value.
#
# @eq: equal
#
# @ne: not equal
#
# @lt: operand less than value
#
# @gt: operand greater than value
#
# @le: operand less than or equal to value
#
# @ge: operand greater than or equal to value
#
# Since: 10.2
##
{ 'enum': 'XemuHookCmp', 'data': [ 'eq', 'ne', 'lt', 'gt', 'le', 'ge' ] }

##
# @XemuHookType:
#
# How a hook condition reads its operand.
#
# @u: unsigned integer
#
# @s: signed (two's complement) integer
#
# @f: IEEE float (@size 4 or 8); a NaN compares unequal to everything
#
# Since: 10.2
##
{ 'enum': 'XemuHookType', 'data': [ 'u', 's', 'f' ] }

##
# @XemuHookCond:
#
# One comparison, made each time execution reaches the hook's PC.
# Exactly one of @reg and @addr names the operand.
#
# @reg: compare this register (4 bytes)
#
# @addr: compare the @size bytes at this guest virtual address (CPU
#     0's page tables at that moment, guest RAM only; unreadable
#     memory makes the condition false).  An expression: a register
#     (eax ecx edx ebx esp ebp esi edi eip) or a constant, then
#     '+'/'-' constants, where [ ] reads the 32-bit pointer at what it
#     encloses, at most 8 deep, e.g. "esp+0x14", "0x2f1c40" or
#     "[[ecx+0x20]]+0x15c"
#
# @size: bytes read at @addr: 1, 2, 4 or 8 (default 4)
#
# @type: how operand and @value compare (default u)
#
# @op: the comparison, operand @op @value
#
# @value: a JSON number, or a string holding one ("0x8c230"); for u
#     and s an integer the operand's size can hold
#
# Since: 10.2
##
{ 'struct': 'XemuHookCond',
  'data': { '*reg': 'XemuHookReg', '*addr': 'str', '*size': 'int',
            '*type': 'XemuHookType', 'op': 'XemuHookCmp', 'value': 'any' } }

##
# @XemuUntil:
#
# A guest PC that ends @xemu-run-until.
#
# @pc: linear address (EIP on the Xbox) of an instruction's first byte
#
# @cond: comparisons that must all hold for an arrival at @pc to count
#     as a hit (default none: every arrival counts; at most 16)
#
# Since: 10.2
##
{ 'struct': 'XemuUntil',
  'data': { 'pc': 'uint64', '*cond': ['XemuHookCond'] } }

##
# @XemuRunUntilReason:
#
# What ended @xemu-run-until or @xemu-run.
#
# @hit: the @hits'th hit; the VM is paused before that instruction
#
# @budget: @frames vblanks ran first; the VM is paused there
#
# @debug: a gdbstub breakpoint or step stopped the VM first; it is
#     left stopped for the debugger
#
# @stopped: something else stopped the VM first (see
#     @XemuFrameInfo's @stopped: a gdbstub client attaching or sending
#     ^C, an I/O error...); it is left as that stop left it
#
# @mismatch: an @xemu-hooks-set hook's hit differed from its @expect
#     entry first; the VM is paused before that instruction (see
#     @XemuHookTrace's @stop)
#
# @empty: an @xemu-hooks-set hook with @stop-empty found its @set
#     queue empty first; the VM is paused before that instruction (see
#     @XemuHookTrace's @stop)
#
# @value: (@xemu-run only) an @addr stop's check fired; the VM is
#     paused on that vblank, before the guest sees it
#
# Since: 10.2
##
{ 'enum': 'XemuRunUntilReason',
  'data': [ 'hit', 'budget', 'debug', 'stopped', 'mismatch', 'empty',
            'value' ] }

##
# @XemuRegs:
#
# The general registers at a hit (the instruction not yet executed).
#
# @eax: EAX
#
# @ecx: ECX
#
# @edx: EDX
#
# @ebx: EBX
#
# @esp: ESP
#
# @ebp: EBP
#
# @esi: ESI
#
# @edi: EDI
#
# @eip: EIP
#
# @eflags: EFLAGS
#
# Since: 10.2
##
{ 'struct': 'XemuRegs',
  'data': { 'eax': 'uint32', 'ecx': 'uint32', 'edx': 'uint32',
            'ebx': 'uint32', 'esp': 'uint32', 'ebp': 'uint32',
            'esi': 'uint32', 'edi': 'uint32', 'eip': 'uint32',
            'eflags': 'uint32' } }

##
# @XemuRunUntilInfo:
#
# @reason: what ended the run
#
# @frame: the frame counter (see @query-xemu-frame) at the end
#
# @running: whether the VM still runs (false unless something resumed
#     it)
#
# @hits: hits counted (equals the request's @hits when @reason is hit)
#
# @pc: the hit's PC (only with @reason hit, mismatch or empty)
#
# @index: which @until entry the hit matched, from 0 (only with
#     @reason hit; the first that matched).  For @xemu-run, which
#     @stop-when entry ended the run (with @reason hit or value)
#
# @regs: the registers at the hit (only with @reason hit, mismatch or
#     empty)
#
# @trace: the samples, as @xemu-frame-advance returns them (only when
#     given @trace; a run that ends at a hit has no sample for the
#     unfinished frame)
#
# @hooks: as @XemuFrameInfo's @hooks
#
# @stopped: as @XemuFrameInfo's @stopped (only with @reason debug or
#     stopped)
#
# Since: 10.2
##
{ 'struct': 'XemuRunUntilInfo',
  'data': { 'reason': 'XemuRunUntilReason', 'frame': 'int',
            'running': 'bool', 'hits': 'int', '*pc': 'uint64',
            '*index': 'int', '*regs': 'XemuRegs',
            '*trace': ['XemuTraceSample'], '*hooks': 'XemuHookTrace',
            '*stopped': 'RunState' } }

##
# @xemu-run-until:
#
# Run the VM, as @xemu-frame-advance does, until execution reaches one
# of the @until PCs with its conditions true for the @hits'th time, or
# for @frames vblanks, whichever comes first, then pause it.  A hit
# stops the VM before the instruction, without the gdbstub: a debugger
# that attaches sees the VM halted there, with no pending stop to
# report.  Arrivals that don't match leave the VM running.  An arrival
# at the instruction the run starts from doesn't count (the run steps
# off it first), so consecutive calls walk from hit to hit.  Under
# -icount the result is exact and repeatable, and a run cut into hits
# ends on the same RAM as one uninterrupted run.  gdbstub breakpoints
# keep working alongside.  The hooks exist only during the call; their
# first use at a PC retranslates that code page once.  The VM must be
# stopped: paused, prelaunch, or stopped by the debugger.
#
# @until: PCs that end the run (1 to 64 entries)
#
# @hits: matching arrivals to count, across all entries (default 1)
#
# @frames: the budget in vblanks
#
# @trace: as for @xemu-frame-advance
#
# @trace-every: as for @xemu-frame-advance
#
# Since: 10.2
##
{ 'command': 'xemu-run-until',
  'data': { 'until': ['XemuUntil'], '*hits': 'int', 'frames': 'int',
            '*trace': ['XemuTraceRegion'], '*trace-every': 'int' },
  'returns': 'XemuRunUntilInfo', 'coroutine': true }

##
# Guest PC hooks: collect
# =======================
##

##
# @XemuHookRegion:
#
# Guest memory a hook reads (or writes) at each hit.
#
# @addr: guest virtual address (CPU 0's page tables at the hit, guest
#     RAM only), an expression as for @XemuHookCond's @addr, e.g.
#     "esp+0x14" or "[[[[0x83a6e2c0+0x20]+0x154]+0xcc]+0x20]+0x38"
#
# @size: bytes: 1 to 4096 for @XemuHookSpec's @collect and @write, 1
#     to 64 for its @key
#
# Since: 10.2
##
{ 'struct': 'XemuHookRegion',
  'data': { 'addr': 'str', 'size': 'int' } }

##
# @XemuHookSpec:
#
# A hook for @xemu-hooks-set.  An arrival at one of @pcs, before that
# instruction runs, with all of @cond true and, given @key, the key's
# bytes changed, is a hit: the hook copies @collect into a record,
# checks it against its @expect entry, writes its next @set entry over
# @write, and the VM runs on.
#
# @pcs: linear addresses (EIP on the Xbox) of instructions' first
#     bytes, 1 to 16; arrivals at any of them are hits of this one
#     hook, numbered together (e.g. a function's RETs)
#
# @cond: comparisons that must all hold, as for @XemuUntil (at most
#     16)
#
# @key: a hit counts only when these bytes differ from the key at the
#     hook's previous hit (the first always counts; an unreadable key
#     makes no hit), e.g. {"addr": "ecx+0x18", "size": 8}, an event
#     clock, so a second call in the same tick is no hit
#
# @collect: memory to copy into each hit's record (at most 64 regions,
#     64 KiB in all; default none)
#
# @regs: also record the general registers (default false)
#
# @expect: one hex string per hit, in hit order: what the hit's
#     collected bytes (the @collect regions concatenated) must start
#     with.  "??" matches any byte and "" checks nothing; hits past
#     the end are not checked.  A hit whose bytes differ, or whose
#     checked bytes are unreadable, is a mismatch.
#
# @stop: a mismatch ends the running @xemu-frame-advance or
#     @xemu-run-until with the VM paused before that instruction
#     (default true); false only marks the record.  Outside those the
#     VM runs on.  A hook with @write takes the hit's @set entry but
#     writes it only when the VM resumes, before the instruction runs
#     again: the stop shows the state the check saw.
#
# @write: guest memory a hit writes (at most 64 regions, 64 KiB in
#     all; sizes 1 to 4096), at address expressions as for @collect,
#     each evaluated after @collect is read, just before its bytes are
#     written.  Only guest RAM is written, as a gdbstub write does
#     (translated code over it is dropped); a region whose address
#     doesn't resolve, or whose bytes aren't all guest RAM, is
#     skipped.  Page permissions don't apply.
#
# @set: the write queue: one hex string per entry, over the @write
#     regions concatenated.  Each hit takes the next entry and writes
#     it before the instruction runs.  "??" leaves a byte as it is, a
#     string shorter than the regions writes only that much, and ""
#     writes nothing.  A hit with no entry left writes nothing (see
#     @stop-empty); @xemu-hooks-push appends entries.  Needs @write.
#
# @stop-empty: a hit that finds the @set queue empty ends the running
#     @xemu-frame-advance or @xemu-run-until before that instruction,
#     as a mismatch does (default false).  If entries are pushed
#     before the VM resumes, that hit takes the first of them when it
#     does, and is recorded again with it.  Needs @write.
#
# Since: 10.2
##
{ 'struct': 'XemuHookSpec',
  'data': { 'pcs': ['uint64'], '*cond': ['XemuHookCond'],
            '*key': 'XemuHookRegion', '*collect': ['XemuHookRegion'],
            '*regs': 'bool', '*expect': ['str'], '*stop': 'bool',
            '*write': ['XemuHookRegion'], '*set': ['str'],
            '*stop-empty': 'bool' } }

##
# @XemuHookInfo:
#
# @id: the hook's id, for @xemu-hooks-clear and its records
#
# @pcs: its PCs
#
# @hits: its hits so far
#
# @queued: @set entries waiting (only for hooks with @write)
#
# Since: 10.2
##
{ 'struct': 'XemuHookInfo',
  'data': { 'id': 'int', 'pcs': ['uint64'], 'hits': 'int',
            '*queued': 'int' } }

##
# @XemuHookRecord:
#
# One hit of an @xemu-hooks-set hook.
#
# @hook: the hook's id
#
# @pc: where it was hit
#
# @frame: the frame counter at the hit (see @query-xemu-frame)
#
# @hit: the hook's hit number, from 0 (also its @expect index)
#
# @data: one lowercase hex string per @collect region, in order; an
#     empty string when guest RAM does not back the whole region
#
# @regs: the registers before the instruction (only with the hook's
#     @regs)
#
# @mismatch: true when the hit differed from its @expect entry
#
# @set: which @set entry the hit took, from 0, counting every entry
#     the hook was given (only for hooks with @write that found an
#     entry)
#
# @empty: true when the hit found the @set queue empty and wrote
#     nothing (only for hooks with @write)
#
# @unwritten: true when part of the entry was not written (a @write
#     region whose address didn't resolve or isn't guest RAM; the rest
#     was written)
#
# Since: 10.2
##
{ 'struct': 'XemuHookRecord',
  'data': { 'hook': 'int', 'pc': 'uint64', 'frame': 'int', 'hit': 'int',
            'data': ['str'], '*regs': 'XemuRegs', '*mismatch': 'bool',
            '*set': 'int', '*empty': 'bool', '*unwritten': 'bool' } }

##
# @XemuHookTrace:
#
# @records: the hits since the last reply that carried records, in
#     execution order, cleared hooks' included
#
# @dropped: hits left out because 262,144 records or 16 MiB of
#     collected bytes were already waiting
#
# @stop: the mismatch, or the empty queue (@stop-empty), that ended
#     this advance (also the last of @records); the VM is paused
#     before its instruction
#
# Since: 10.2
##
{ 'struct': 'XemuHookTrace',
  'data': { 'records': ['XemuHookRecord'], 'dropped': 'int',
            '*stop': 'XemuHookRecord' } }

##
# @xemu-hooks-set:
#
# Install hooks at guest PCs that copy guest memory at each hit, and
# write queued bytes, without stopping the VM.  They stay until
# @xemu-hooks-clear, across advances and loads (hit numbers, keys and
# queues too; clear and set them again to start over).  Their records
# come back with the next @xemu-frame-advance or @xemu-run-until reply
# (@frames 0 just returns them), or from @xemu-hooks-drain, which
# leaves the VM running.  Under -icount the records are exact
# and repeatable, and hooks change what the guest does only through
# their @set writes, at the same instruction every run.  gdbstub
# breakpoints and @xemu-run-until work alongside; a hook at the PC of
# either sees that arrival once.  The first hook at a PC retranslates
# its code page once.  The VM must be stopped: paused, prelaunch, or
# stopped by the debugger.
#
# @hooks: the hooks to add (at most 64 installed)
#
# Returns: the new hooks, in request order
#
# Since: 10.2
##
{ 'command': 'xemu-hooks-set', 'data': { 'hooks': ['XemuHookSpec'] },
  'returns': ['XemuHookInfo'] }

##
# @xemu-hooks-clear:
#
# Remove @xemu-hooks-set hooks.  Records they made stay until the
# next reply that carries records.
#
# @ids: the hooks to remove (default all)
#
# Since: 10.2
##
{ 'command': 'xemu-hooks-clear', 'data': { '*ids': ['int'] } }

##
# @query-xemu-hooks:
#
# List the installed @xemu-hooks-set hooks.
#
# Since: 10.2
##
{ 'command': 'query-xemu-hooks', 'returns': ['XemuHookInfo'] }

##
# @xemu-hooks-drain:
#
# Take the @xemu-hooks-set records waiting, those the next
# @xemu-frame-advance or @xemu-run-until reply would carry, without
# pausing the VM: it may be running, and its hooks record on from
# where the call cut, so successive calls return every hit once, in
# execution order.  QMP runs one command at a time: a call sent during
# an @xemu-frame-advance, @xemu-run-until or @xemu-run waits for its
# reply, which takes the records itself.
#
# Returns: the records and @dropped, as in those replies (no @stop)
#
# Since: 10.2
##
{ 'command': 'xemu-hooks-drain', 'returns': 'XemuHookTrace' }

##
# Guest PC hooks: write queues
# ============================
##

##
# @xemu-hooks-push:
#
# Append entries to the @set queue of an @xemu-hooks-set hook with
# @write.  The VM must be stopped: paused, prelaunch, or stopped by
# the debugger.  At most 1,048,576 entries or 64 MiB wait per hook.
#
# @id: the hook
#
# @set: the entries, as for @XemuHookSpec's @set
#
# Returns: the hook, with its @queued count
#
# Since: 10.2
##
{ 'command': 'xemu-hooks-push', 'data': { 'id': 'int', 'set': ['str'] },
  'returns': 'XemuHookInfo' }

##
# Candidate runs in one call: xemu-run
# ====================================
##

##
# @XemuRunStop:
#
# A condition that ends @xemu-run.  Exactly one of @pc and @addr
# names it: a guest PC, as an @XemuUntil entry, or a value in guest
# memory that leaves [@lo, @hi] or, with @change, changes.  A value
# is checked at every vblank of the run, where @xemu-frame-advance
# takes its trace samples, before the guest sees that vblank; the run
# then ends on that vblank, sampled.  A value that becomes unreadable
# (an expression that no longer resolves to guest RAM) lies outside
# any range and has changed, as does one that becomes readable.  Each
# @addr entry needs @lo, @hi or @change.
#
# @pc: linear address (EIP on the Xbox) of an instruction's first
#     byte; the run ends before that instruction, as at an
#     @xemu-run-until hit
#
# @cond: with @pc: comparisons that must all hold, as for @XemuUntil
#     (at most 16)
#
# @addr: the value's guest virtual address, an expression as for
#     @XemuHookCond's @addr (registers read where the vCPU was at the
#     vblank, so prefer constants and [ ] reads)
#
# @size: the value's bytes: 1, 2, 4 or 8 (default 4)
#
# @type: how @lo and @hi compare with it (default u); a float NaN
#     lies outside every range
#
# @lo: the run ends at the first check that finds the value below
#     @lo, a number or a numeric string as @XemuHookCond's @value
#     (default no lower bound)
#
# @hi: likewise, above @hi (default no upper bound)
#
# @change: the run ends at the first check whose bytes differ from
#     those at the run's start (default false)
#
# Since: 10.2
##
{ 'struct': 'XemuRunStop',
  'data': { '*pc': 'uint64', '*cond': ['XemuHookCond'], '*addr': 'str',
            '*size': 'int', '*type': 'XemuHookType', '*lo': 'any',
            '*hi': 'any', '*change': 'bool' } }

##
# @XemuRunInfo:
#
# What @xemu-run returns: what @xemu-run-until does (@hits counts @pc
# stop hits, and @index names the @stop-when entry that ended the
# run), and these.
#
# @frames: vblanks the run delivered
#
# @data: the value's bytes in guest memory order, as lowercase hex,
#     "" when unreadable (only with @reason value)
#
# @previous: its bytes at the check before, or at the start of the
#     run (only with @reason value)
#
# Since: 10.2
##
{ 'struct': 'XemuRunInfo', 'base': 'XemuRunUntilInfo',
  'data': { 'frames': 'int', '*data': 'str', '*previous': 'str' } }

##
# @xemu-run:
#
# One candidate run in one call: restore @checkpoint, queue @input,
# then run as @xemu-run-until does, for @frames vblanks or until a
# @stop-when entry ends it, and pause.  Nothing runs between the
# restore, the queueing and the start, so frame-tagged input lands on
# the same vblank every time, with no pipe to race.  Under -icount the
# same checkpoint, input and stops give the same RAM, trace and reply
# every time, but for frame counter values (a restore doesn't rewind
# the counter), while no @xemu-hooks-set hook is installed: hooks keep
# their hit numbers, keys and @set queues across the restore (clear
# and set them again before each run to start over).  The VM must be
# stopped: paused, prelaunch, or stopped by the debugger.  Nothing is
# changed when an argument is refused.
#
# @checkpoint: an @xemu-checkpoint-save checkpoint to restore first,
#     as @xemu-checkpoint-restore does (default: run on from the
#     current state)
#
# @incremental: restore @checkpoint as @xemu-checkpoint-restore's
#     @incremental does (default true; false compares every page, as
#     after RAM writes the dirty log can't see, from XEMU_RAM_SHM)
#
# @input: XEMU_INPUT_PIPE lines (at most 65,536), queued in order
#     after the restore as if written to the pipe then: "+N" counts
#     vblanks from there ("+0" and "+1" both mean the run's first
#     vblank), "@N" names a frame counter value, and an untagged line
#     applies at the first vblank under -icount, at once otherwise.  A
#     line is "down N", "up N" (N an SDL scancode), "clear", "axis
#     lx|ly|rx|ry V" or "trigger lt|rt V"; any other is refused, but
#     for blank lines and '#' comments (as XEMU_INPUT_RECORD writes),
#     which are skipped, as the pipe ignores them.  Lines still queued
#     at the end stay queued for the next run, and a restore drops
#     them.
#
# @frames: the budget in vblanks (0 just restores and queues)
#
# @trace: as for @xemu-frame-advance
#
# @trace-every: as for @xemu-frame-advance
#
# @stop-when: conditions that end the run early (at most 64)
#
# @hits: @pc stop hits to count, across all @pc entries (default 1)
#
# Since: 10.2
##
{ 'command': 'xemu-run',
  'data': { '*checkpoint': 'str', '*incremental': 'bool',
            '*input': ['str'], 'frames': 'int',
            '*trace': ['XemuTraceRegion'], '*trace-every': 'int',
            '*stop-when': ['XemuRunStop'], '*hits': 'int' },
  'returns': 'XemuRunInfo', 'coroutine': true }

##
# Guest memory access log
# =======================
##

##
# @XemuWatchAccess:
#
# Which accesses a watched range logs, or what a logged access did.
#
# @r: reads
#
# @w: writes
#
# @rw: reads and writes; in a hit, an atomic read-modify-write
#
# Since: 10.2
##
{ 'enum': 'XemuWatchAccess', 'data': [ 'r', 'w', 'rw' ] }

##
# @XemuWatchRange:
#
# Guest memory whose CPU accesses @xemu-watch-start logs.
#
# @address: physical address, or with @virtual a virtual one
#
# @size: bytes, 1 to 16 MiB; the range must end at or below 4 GiB
#
# @virtual: match the virtual addresses accesses use (default false:
#     match physical addresses, so every mapping of the RAM is seen,
#     the 0xF0000000 window included).  A physical range lies in RAM
#     or entirely outside it (device MMIO).
#
# @access: the accesses to log
#
# Since: 10.2
##
{ 'struct': 'XemuWatchRange',
  'data': { 'address': 'uint64', 'size': 'uint64', '*virtual': 'bool',
            'access': 'XemuWatchAccess' } }

##
# @XemuWatchHit:
#
# One CPU access that overlapped a watched range.
#
# @frame: the frame counter (see @query-xemu-frame) at the access
#
# @pc: linear address of the instruction that made it (EIP plus the
#     CS base, which is 0 on the Xbox)
#
# @address: virtual address of the access
#
# @physical: physical address of the access
#
# @size: bytes accessed (an access that crosses a page is logged as
#     one hit per page)
#
# @access: r, w, or rw for an atomic read-modify-write
#
# @value: the bytes accessed, in memory order, as lowercase hex (at
#     most the first 64): what a read read, and what a write left
#     there, read back at the next logged access or at the end of the
#     current translated block (a logged write kicks the vCPU so that
#     it reads the bytes back there).  Absent for device MMIO, whose
#     reads have side effects.
#
# @ram-address: for an access that reached guest RAM at another
#     physical address than its own, through the NV2A's BAR1 window at
#     0xF0000000, which maps all of RAM: the RAM address it reached,
#     i.e. the same byte's address in the low mapping, also its offset
#     in @xemu-dump-ram's file and in XEMU_RAM_SHM (an access at
#     @physical 0xF4100000 on 128 MiB has @ram-address 0x4100000).
#     Absent when it equals @physical and for device MMIO, so a log
#     of accesses at RAM's own addresses is unchanged (since 10.2;
#     xemu-macos 0.16.1)
#
# Since: 10.2
##
{ 'struct': 'XemuWatchHit',
  'data': { 'frame': 'int', 'pc': 'uint64', 'address': 'uint64',
            'physical': 'uint64', 'size': 'int',
            'access': 'XemuWatchAccess', '*value': 'str',
            '*ram-address': 'uint64' } }

##
# @XemuWatchLog:
#
# @hits: the logged accesses, in the order the guest made them
#
# @dropped: accesses past @xemu-watch-start's max that were counted
#     but not kept
#
# Since: 10.2
##
{ 'struct': 'XemuWatchLog',
  'data': { 'hits': ['XemuWatchHit'], 'dropped': 'int' } }

##
# @xemu-watch-start:
#
# Start logging the CPU's accesses to @ranges without stopping the
# VM: while it runs (@xemu-frame-advance, cont, the gdbstub), every
# load or store that overlaps a range of the right access is kept
# with its frame, pc, address, size and value.  Under -icount the log
# is the same in every run, and the guest runs exactly as it would
# without the log.  Device DMA is not seen.  Start it with the VM
# paused for a log that begins at an exact instruction.
#
# @ranges: what to watch, 1 to 64 ranges
#
# @max: the most hits to keep until the next @xemu-watch-drain or
#     @xemu-watch-stop, 1 to 1000000 (default 100000)
#
# Since: 10.2
##
{ 'command': 'xemu-watch-start',
  'data': { 'ranges': ['XemuWatchRange'], '*max': 'int' } }

##
# @xemu-watch-drain:
#
# Return the hits logged since the start or the last drain, and keep
# logging.
#
# Since: 10.2
##
{ 'command': 'xemu-watch-drain', 'returns': 'XemuWatchLog' }

##
# @xemu-watch-stop:
#
# Stop logging and return the hits logged since the start or the last
# drain.
#
# Since: 10.2
##
{ 'command': 'xemu-watch-stop', 'returns': 'XemuWatchLog' }

##
# Controller port bindings
# ========================
##

##
# @XemuInputSource:
#
# A host source for an emulated Xbox pad.
#
# @keyboard: the keyboard pad: the host keyboard (in normal mode, or
#     read at vblanks with XEMU_ICOUNT_LIVE_PADS=1) plus the lines
#     written to XEMU_INPUT_PIPE
#
# @pipe: the same source as @keyboard (the pipe's lines drive the
#     keyboard pad)
#
# @gamepad: a host gamepad, picked by its SDL GUID
#
# @none: no host source; the emulated pad stays plugged and reports
#     neutral input
#
# Since: 10.2
##
{ 'enum': 'XemuInputSource',
  'data': [ 'keyboard', 'pipe', 'gamepad', 'none' ] }

##
# @XemuInputPort:
#
# A controller port: the emulated pad on it and its host source.
#
# @port: the port, 1 to 4
#
# @source: the host source driving the port now (@keyboard, @gamepad
#     or @none)
#
# @name: the source's name
#
# @guid: the gamepad's SDL GUID (with @source @gamepad)
#
# @pad: whether an emulated pad sits on the port (a usb-xbox-gamepad
#     or usb-xbox-gamepad-s whose index is this port)
#
# @driver: the emulated pad's device type
#
# @pinned: the port was bound with @xemu-input-bind: its emulated pad
#     stays plugged while its host gamepad disconnects and reconnects,
#     and auto-binding leaves it alone
#
# @pinned-source: the source @xemu-input-bind asked for
#
# @pinned-guid: the gamepad GUID @xemu-input-bind asked for
#
# @pending: the binding @xemu-input-bind asked for applies at the next
#     vblank (deterministic mode and XEMU_INPUT_RECORD)
#
# Since: 10.2
##
{ 'struct': 'XemuInputPort',
  'data': { 'port': 'int', 'source': 'XemuInputSource', '*name': 'str',
            '*guid': 'str', 'pad': 'bool', '*driver': 'str',
            'pinned': 'bool', '*pinned-source': 'XemuInputSource',
            '*pinned-guid': 'str', 'pending': 'bool' } }

##
# @XemuInputGamepad:
#
# A host gamepad xemu has open.
#
# @name: its name
#
# @guid: its SDL GUID, as the config's [input.bindings] stores it
#
# @port: the port it drives, if any
#
# Since: 10.2
##
{ 'struct': 'XemuInputGamepad',
  'data': { 'name': 'str', 'guid': 'str', '*port': 'int' } }

##
# @XemuInputBindings:
#
# @ports: ports 1 to 4
#
# @gamepads: the host gamepads xemu has open (none in deterministic
#     mode, which opens no host gamepad unless
#     XEMU_ICOUNT_LIVE_PADS=1)
#
# Since: 10.2
##
{ 'struct': 'XemuInputBindings',
  'data': { 'ports': ['XemuInputPort'], 'gamepads': ['XemuInputGamepad'] } }

##
# @query-xemu-input-bindings:
#
# List the controller ports and the host gamepads.
#
# Since: 10.2
##
{ 'command': 'query-xemu-input-bindings', 'returns': 'XemuInputBindings' }

##
# @xemu-input-bind:
#
# Change the host source that drives a port's emulated pad, keeping
# the pad plugged: the guest sees no unplug, and loadvm, checkpoint
# restores and system_reset keep it, as for any bound port.  A port
# with no emulated pad gets one plugged, as binding it in the settings
# does, except with XEMU_ICOUNT_LIVE_PADS=1, where that is an error (a
# replay of the session's input could not repeat the plug).  A source
# bound to another port moves here; that port keeps its pad with no
# source.  The port is then pinned (see @XemuInputPort).  The change
# is not saved to the config.  In deterministic mode and while
# XEMU_INPUT_RECORD records it applies at the next vblank, so it lands
# at a fixed instruction count; otherwise at once.
#
# @port: the port, 1 to 4
#
# @source: the new source
#
# @guid: with @source @gamepad, the gamepad's SDL GUID (32 hex
#     digits).  When several open gamepads share it, one no other
#     port uses is taken.  When none is open, the port reports neutral
#     input until one connects, which then drives it without a replug.
#
# Since: 10.2
##
{ 'command': 'xemu-input-bind',
  'data': { 'port': 'int', 'source': 'XemuInputSource', '*guid': 'str' },
  'returns': 'XemuInputPort' }

##
# Trace recording
# ===============
##

##
# @XemuTraceRecordRegion:
#
# Guest memory that XEMU_TRACE_RECORD writes at every vblank: at
# @address, as for @XemuTraceRegion, or at @addr, as for a hook's
# @collect region (so an @XemuHookRegion is one too).
#
# @address: physical address, or with @virtual a virtual one (CPU 0's
#     page tables at that vblank)
#
# @addr: instead of @address, an address expression as for
#     @XemuHookRegion's @addr, e.g. "[[0x83a6e2c0+0x20]+0x154]": a
#     virtual address, evaluated with CPU 0's registers and page
#     tables at every line, so the region follows pointers the guest
#     moves.
#     Its line field is "?" when a dereference reads memory that is
#     not guest RAM (e.g. through a null pointer), and "-" when the
#     bytes it points at aren't all guest RAM.
#
# @size: bytes to read, 1 to 4096
#
# @virtual: translate @address through the guest page tables (default
#     false); @addr is always virtual, so false is refused with it
#
# Since: 10.2
##
{ 'struct': 'XemuTraceRecordRegion',
  'data': { '*address': 'uint64', '*addr': 'str', 'size': 'int',
            '*virtual': 'bool' } }

##
# @xemu-trace-regions:
#
# Replace the guest memory that XEMU_TRACE_RECORD writes at every
# vblank (initially XEMU_TRACE_REGIONS), from the next vblank on,
# which also writes a "# regions" line.  Fails when XEMU_TRACE_RECORD
# is not set.
#
# @regions: the regions, in line order (at most 256, 1 to 4096 bytes
#     each); an empty list leaves only the vblank counts
#
# Since: 10.2
##
{ 'command': 'xemu-trace-regions',
  'data': { 'regions': ['XemuTraceRecordRegion'] } }

