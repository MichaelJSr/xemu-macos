{ 'struct': 'XemuInputPadState',
  'data': { 'buttons': ['XemuInputButton'], 'lx': 'int', 'ly': 'int',
            'rx': 'int', 'ry': 'int', 'lt': 'int', 'rt': 'int' } }

##
# @XemuInputPortState:
#
# @port: the port, 1 to 4
#
# @source: the host source driving the port (see
#     @query-xemu-input-bindings; a change @xemu-input-bind left
#     pending is not counted)
#
# @next: the input the port's pad reports from the next vblank on.
#     For @keyboard, the lines due at that vblank applied to what the
#     pipe holds, plus the host keyboard in normal mode or with
#     XEMU_ICOUNT_LIVE_PADS (as last read).  For @gamepad, its last
#     reading.  Neutral for @none.  In normal mode host sources and
#     untagged lines also change it between vblanks.
#
# Since: 10.2
##
{ 'struct': 'XemuInputPortState',
  'data': { 'port': 'int', 'source': 'XemuInputSource',
            'next': 'XemuInputPadState' } }

##
# @XemuInputQueuedLine:
#
# @frame: the frame counter at the vblank that applies it
#
# @line: the line, without its "@" or "+" tag
#
# Since: 10.2
##
{ 'struct': 'XemuInputQueuedLine',
  'data': { 'frame': 'int', 'line': 'str' } }

##
# @XemuInputState:
#
# @frame: the frame counter (see @query-xemu-frame); the next vblank
#     is @frame + 1
#
# @ports: ports 1 to 4
#
# @keys: the scancodes the pipe holds down from the next vblank on,
#     whether or not the keyboard map uses them
#
# @queued: the XEMU_INPUT_PIPE lines waiting for a vblank, in the
#     order they apply (in deterministic mode untagged lines too)
#
# Since: 10.2
##
{ 'struct': 'XemuInputState',
  'data': { 'frame': 'int', 'ports': ['XemuInputPortState'],
            'keys': ['int'], 'queued': ['XemuInputQueuedLine'] } }

##
# @query-xemu-input:
#
# Return the pad input every port gets from the next vblank on and the
# XEMU_INPUT_PIPE lines still queued.  Lines written to the pipe
# before the call are read first.  An untagged "clear" line drops
# every queued line and releases all keys and axes (in deterministic
# mode at the next vblank); "+0 clear" releases them at the next
# vblank and keeps the queue.
#
# Since: 10.2
##
{ 'command': 'query-xemu-input', 'returns': 'XemuInputState' }

##
# @XemuInputQueueInfo:
#
# @accepted: lines taken: queued for a vblank, or applied at once (an
#     untagged line in normal mode)
#
# @skipped: blank lines and '#' comments, which the pipe ignores too
#
# @queued: lines now waiting for a vblank (@query-xemu-input lists
#     them)
#
# @frame: the frame counter (see @query-xemu-frame) the call's "+N"
#     lines count from: they apply at @frame + N ("+0" and "+1" both
#     at @frame + 1, the next vblank)
#
# Since: 10.2
##
{ 'struct': 'XemuInputQueueInfo',
  'data': { 'accepted': 'int', 'skipped': 'int', 'queued': 'int',
            'frame': 'int' } }

##
# @xemu-input-queue:
#
# Queue XEMU_INPUT_PIPE lines over QMP, as if written to the pipe now:
# the same grammar ("down N", "up N", "clear", "axis lx|ly|rx|ry V",
# "trigger lt|rt V", each optionally tagged "@N" or "+N") and the same
# semantics, with no pipe and no 8 KiB pipe window (xemu-macos
# 0.16.1).  Lines written to the pipe before the call are read first,
# so both keep their order.  They drive the keyboard pad, on the port
# the keyboard source is bound to (see @xemu-input-bind: "keyboard" or
# "pipe"), whether or not XEMU_INPUT_PIPE is set.  An untagged "clear"
# drops every line queued before it, this call's earlier lines too, as
# on the pipe.  Every line is checked first: one that isn't valid
# refuses the call with its number (counting from 1) and nothing is
# queued.  Blank lines and '#' comments (as XEMU_INPUT_RECORD writes)
# are skipped.  A load or checkpoint restore drops lines still queued,
# as it drops the pipe's.
#
# @lines: the lines, in order (at most 262,144 per call)
#
# Since: 10.2
##
{ 'command': 'xemu-input-queue', 'data': { 'lines': ['str'] },
  'returns': 'XemuInputQueueInfo' }

