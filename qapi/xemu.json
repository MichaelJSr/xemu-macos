#     -icount sleep=off the clock warps straight to the next timer,
#     which costs no host time
#
# @idle-warps: those warps
#
# Since: 10.2
##
{ 'struct': 'XemuHostProfile',
  'data': { 'translate-ns': 'int', 'translations': 'int',
            'apu-ns': 'int', 'apu-ticks': 'int',
            'idle-ns': 'int', 'idle-warps': 'int' } }

